# StratPlan AI Environment Variables
# Copy this file to .env and fill in your values
# All values are optional - the system works with defaults

# App
APP_NAME="StratPlan AI"
VERSION="1.0.0"
DEBUG=true
API_V1_STR="/api/v1"

# Database
# SQLite for dev, PostgreSQL for prod (Supabase, Render, etc.)
DATABASE_URL="sqlite:///./stratplan.db"
# DATABASE_URL="postgresql://user:pass@host:5432/stratplan"

# Ollama (Local LLM) - Required
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="phi3:mini"
# Alternative models: llama3.2:3b, phi3:medium, mistral:7b

# Groq (Optional fallback for faster inference)
# GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxx"

# Free Financial Data APIs (Optional but recommended)
# Alpha Vantage - Industry benchmarks (25 req/day free)
# ALPHA_VANTAGE_API_KEY="XXXXXXXXXXXXXXXX"

# Finnhub - Market news, stock data (60 req/min free)
# FINNHUB_API_KEY="xxxxxxxxxxxxxxxxxxxx"

# FRED - Macroeconomic data (Unlimited free)
# FRED_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Apify - Competitor website scraping ($5/mo free credit)
# APIFY_API_TOKEN="apify_xxxxxxxxxxxxxxxxxxxxxxxx"

# SerpAPI - Search visibility (100 searches/mo free)
# SERPAPI_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# CORS - Frontend origins
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://localhost:3001"]'

# Export directory
EXPORT_DIR="./exports"